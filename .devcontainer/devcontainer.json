{
  "name": "DAQForge",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "type=volume,source=daqforge-venv-${devcontainerId},target=/opt/daqforge-venv"
  ],
  "postCreateCommand": "/usr/local/bin/python -m venv \"$VIRTUAL_ENV\" && python -m pip install -e '.[dev]'",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/daqforge-venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
